# PostgreSQL
DATABASE_URL=postgresql://iot_admin:secure_password123@localhost:5432/infusion_iot

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Security
JWT_SECRET=change-me-to-a-strong-random-string

# CORS
CORS_ORIGINS=*

